---
import { CommunityLink } from '../../types/cms';

interface Props {
  enabled?: boolean;
  title?: string;
  subtitle?: string;
  communityLinks?: CommunityLink[];
}

const {
  enabled = true,
  title = 'Join Our Community',
  subtitle = 'Get the latest updates, resources, new articles and exclusive content directly through our social channels.',
  communityLinks = [],
} = Astro.props;

const DEFAULT_LINKS: CommunityLink[] = [
  { id: 'comm-1', platform: 'telegram', label: 'Join Telegram', url: 'https://t.me/astropress', enabled: true, order: 1 },
  { id: 'comm-2', platform: 'whatsapp', label: 'Join WhatsApp', url: 'https://chat.whatsapp.com/astropress', enabled: true, order: 2 },
  { id: 'comm-3', platform: 'youtube', label: 'Subscribe on YouTube', url: 'https://youtube.com/@astropress', enabled: true, order: 3 },
];

const linksToRender = (communityLinks && communityLinks.length > 0)
  ? communityLinks.filter((l) => l.enabled)
  : DEFAULT_LINKS;

const getLinkColors = (platform: string) => {
  switch (platform) {
    case 'telegram':
      return {
        cardBg: 'from-[#0088cc]/10 hover:from-[#0088cc]/20 border-[#0088cc]/30 hover:border-[#0088cc]',
        buttonBg: 'bg-[#0088cc] hover:bg-[#0077b5] text-white',
        text: 'text-[#0088cc]',
      };
    case 'whatsapp':
      return {
        cardBg: 'from-[#25D366]/10 hover:from-[#25D366]/20 border-[#25D366]/30 hover:border-[#25D366]',
        buttonBg: 'bg-[#25D366] hover:bg-[#20bd5a] text-white',
        text: 'text-[#25D366]',
      };
    case 'youtube':
      return {
        cardBg: 'from-[#FF0000]/10 hover:from-[#FF0000]/20 border-[#FF0000]/30 hover:border-[#FF0000]',
        buttonBg: 'bg-[#FF0000] hover:bg-[#cc0000] text-white',
        text: 'text-[#FF0000]',
      };
    case 'twitter':
      return {
        cardBg: 'from-slate-800/10 hover:from-slate-800/20 border-slate-700/30 hover:border-slate-900',
        buttonBg: 'bg-slate-900 hover:bg-black text-white',
        text: 'text-slate-900',
      };
    case 'discord':
      return {
        cardBg: 'from-[#5865F2]/10 hover:from-[#5865F2]/20 border-[#5865F2]/30 hover:border-[#5865F2]',
        buttonBg: 'bg-[#5865F2] hover:bg-[#4752c4] text-white',
        text: 'text-[#5865F2]',
      };
    default:
      return {
        cardBg: 'from-blue-600/10 hover:from-blue-600/20 border-blue-500/30 hover:border-blue-600',
        buttonBg: 'bg-blue-600 hover:bg-blue-700 text-white',
        text: 'text-blue-600',
      };
  }
};
---

{enabled && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 w-full">
    <div class="relative overflow-hidden rounded-3xl bg-linear-to-b from-slate-900 via-slate-900 to-slate-950 text-white p-8 sm:p-12 md:p-14 border border-slate-800 shadow-2xl">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-600/20 rounded-full blur-3xl pointer-events-none" />
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-600/15 rounded-full blur-3xl pointer-events-none" />

      <div class="relative z-10 max-w-3xl mx-auto text-center space-y-4 sm:space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-semibold text-blue-200">
          <span>●</span>
          <span>Community & Direct Channels</span>
        </div>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
          {title}
        </h2>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
          {subtitle}
        </p>

        <div class="pt-6 sm:pt-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {linksToRender.map((link) => {
            const colors = getLinkColors(link.platform);
            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`group flex items-center justify-between p-4 rounded-2xl bg-linear-to-br to-transparent border backdrop-blur-xs transition-all duration-300 hover:scale-[1.02] hover:shadow-lg ${colors.cardBg}`}
              >
                <div class="flex items-center gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold text-xs">
                    {link.platform.slice(0, 2).toUpperCase()}
                  </div>
                  <div class="text-left">
                    <span class="block text-sm font-bold text-white group-hover:text-blue-200 transition-colors">
                      {link.label}
                    </span>
                    <span class="block text-[11px] text-slate-400 capitalize">
                      {link.platform} Channel
                    </span>
                  </div>
                </div>

                <div
                  class={`px-3 py-1.5 rounded-xl font-bold text-xs shadow-xs transition-transform group-hover:translate-x-0.5 ${colors.buttonBg}`}
                >
                  Join →
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
