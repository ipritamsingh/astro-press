---
import { parseMarkdownToBlocks } from './GutenbergBlockRenderer';
import { detectAndParseTable } from './tableParser';
import { GutenbergBlock } from '../../types/cms';

interface Props {
  blocks?: GutenbergBlock[];
  rawMarkdown?: string;
}

const { blocks, rawMarkdown } = Astro.props;

const renderBlocks = (blocks && blocks.length > 0)
  ? blocks
  : (rawMarkdown ? parseMarkdownToBlocks(rawMarkdown) : []);

function renderInlineMarkdownToHtml(text: string): string {
  if (!text) return '';
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-blue-600 underline hover:text-blue-700">$1</a>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/__(.*?)__/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/_(.*?)_/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code class="bg-slate-100 text-slate-800 px-1.5 py-0.5 rounded text-sm font-mono">$1</code>')
    .replace(/\n/g, '<br />');
}
---

<div class="space-y-6 text-slate-800 leading-relaxed font-normal">
  {renderBlocks.map((block) => {
    const { id, type, content, settings = {} } = block;

    if (type === 'heading') {
      const level = settings.level || 2;
      const alignClass =
        settings.align === 'center'
          ? 'text-center'
          : settings.align === 'right'
          ? 'text-right'
          : 'text-left';
      const commonHeadingClasses = `font-extrabold text-slate-900 tracking-tight font-serif-custom ${alignClass} ${settings.customClasses || ''}`;

      if (level === 1) {
        return <h1 id={id} class={`text-3xl md:text-5xl mt-8 mb-4 ${commonHeadingClasses}`}>{content}</h1>;
      }
      if (level === 2) {
        return <h2 id={id} class={`text-2xl md:text-3xl mt-8 mb-4 border-b border-slate-100 pb-2 ${commonHeadingClasses}`}>{content}</h2>;
      }
      if (level === 3) {
        return <h3 id={id} class={`text-xl md:text-2xl mt-6 mb-3 ${commonHeadingClasses}`}>{content}</h3>;
      }
      return <h4 id={id} class={`text-lg md:text-xl mt-4 mb-2 ${commonHeadingClasses}`}>{content}</h4>;
    }

    if (type === 'paragraph') {
      const sizeClass =
        settings.fontSize === 'small'
          ? 'text-sm'
          : settings.fontSize === 'large'
          ? 'text-xl leading-relaxed'
          : settings.fontSize === 'huge'
          ? 'text-2xl leading-relaxed font-light'
          : 'text-base md:text-lg leading-relaxed';

      const alignClass =
        settings.align === 'center'
          ? 'text-center'
          : settings.align === 'right'
          ? 'text-right'
          : 'text-left';

      return (
        <p
          id={id}
          class={`${sizeClass} ${alignClass} text-slate-700 font-normal ${settings.customClasses || ''}`}
          set:html={renderInlineMarkdownToHtml(content)}
        />
      );
    }

    if (type === 'quote') {
      return (
        <figure
          id={id}
          class={`my-6 rounded-r-xl border-l-4 p-5 md:p-6 shadow-sm border-blue-600 bg-slate-50/80 ${settings.customClasses || ''}`}
        >
          <div class="flex gap-3">
            <span class="text-blue-600 font-serif text-3xl leading-none opacity-70">“</span>
            <div>
              <blockquote
                class="text-lg md:text-xl italic font-serif-custom text-slate-800 leading-snug"
                set:html={renderInlineMarkdownToHtml(content)}
              />
              {settings.imageCaption && (
                <figcaption class="mt-3 text-xs uppercase tracking-wider font-semibold text-slate-500">
                  — {settings.imageCaption}
                </figcaption>
              )}
            </div>
          </div>
        </figure>
      );
    }

    if (type === 'code') {
      return (
        <div id={id} class="relative my-6 rounded-xl bg-slate-900 text-slate-100 p-4 md:p-5 font-mono text-sm shadow-md overflow-hidden">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3 text-xs text-slate-400">
            <span class="font-semibold uppercase tracking-wider">
              {settings.codeLanguage || 'TypeScript'}
            </span>
          </div>
          <pre class="overflow-x-auto whitespace-pre-wrap leading-relaxed">
            <code>{content}</code>
          </pre>
        </div>
      );
    }

    if (type === 'image') {
      const imageUrl = settings.imageUrl || content;
      const captionText = (settings.imageCaption &&
        !settings.imageCaption.toLowerCase().includes('webp optimized') &&
        !settings.imageCaption.toLowerCase().includes('saved '))
        ? settings.imageCaption
        : undefined;

      return (
        <figure id={id} class="my-8 text-center">
          <div class="overflow-hidden rounded-xl bg-slate-100 shadow-sm border border-slate-200/60 max-w-4xl mx-auto">
            <img
              src={imageUrl || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80'}
              alt={settings.imageAlt || 'Article illustration'}
              class="w-full h-auto object-cover max-h-[550px] transition-transform duration-300 hover:scale-[1.01]"
              loading="lazy"
            />
          </div>
          {captionText && (
            <figcaption class="mt-2.5 text-xs md:text-sm text-slate-500 italic">
              {captionText}
            </figcaption>
          )}
        </figure>
      );
    }

    if (type === 'columns') {
      const cols = settings.columns || [
        { id: 'c1', content: 'Column 1 Content' },
        { id: 'c2', content: 'Column 2 Content' },
      ];
      const layout = settings.columnLayout || '50-50';

      const gridClass =
        layout === '33-33-33'
          ? 'grid-cols-1 md:grid-cols-3'
          : layout === '70-30'
          ? 'grid-cols-1 md:grid-cols-3'
          : 'grid-cols-1 md:grid-cols-2';

      return (
        <div id={id} class={`grid ${gridClass} gap-6 my-6`}>
          {cols.map((col: any, idx: number) => {
            const colSpan =
              layout === '70-30' ? (idx === 0 ? 'md:col-span-2' : 'md:col-span-1') : '';
            return (
              <div class={`rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs ${colSpan}`}>
                <div
                  class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-sm md:text-base whitespace-pre-line"
                  set:html={renderInlineMarkdownToHtml(col.content)}
                />
              </div>
            );
          })}
        </div>
      );
    }

    if (type === 'alert') {
      const alertType = settings.alertType || 'info';
      const isWarn = alertType === 'warning';
      const isSuccess = alertType === 'success';
      const isDanger = alertType === 'danger';
      const colorClass = isWarn
        ? 'bg-amber-50/90 text-amber-900 border-amber-200'
        : isSuccess
        ? 'bg-emerald-50/90 text-emerald-900 border-emerald-200'
        : isDanger
        ? 'bg-rose-50/90 text-rose-900 border-rose-200'
        : 'bg-blue-50/90 text-blue-900 border-blue-200';
      const title = isWarn ? 'Attention' : isSuccess ? 'Success' : isDanger ? 'Warning' : 'Note';

      return (
        <div id={id} class={`my-6 flex items-start gap-3.5 rounded-xl border p-4.5 shadow-2xs ${colorClass}`}>
          <div class="text-sm md:text-base font-normal leading-relaxed">
            <span class="font-semibold block mb-0.5">{title}</span>
            <div set:html={renderInlineMarkdownToHtml(content)} />
          </div>
        </div>
      );
    }

    if (type === 'accordion') {
      const items = settings.accordionItems || [
        { title: 'Item 1 Question', content: 'Item 1 detailed explanation' },
      ];

      return (
        <div id={id} class="my-6 space-y-2.5">
          {items.map((item: any) => (
            <details class="group rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs transition-colors">
              <summary class="flex w-full items-center justify-between px-5 py-4 text-left font-semibold text-slate-800 hover:bg-slate-50 transition-colors cursor-pointer select-none">
                <span class="text-base">{item.title}</span>
                <span class="text-slate-500 group-open:rotate-180 transition-transform duration-200 text-sm">▼</span>
              </summary>
              <div
                class="border-t border-slate-100 px-5 py-4 text-sm md:text-base text-slate-600 leading-relaxed bg-slate-50/50"
                set:html={renderInlineMarkdownToHtml(item.content)}
              />
            </details>
          ))}
        </div>
      );
    }

    if (type === 'list') {
      const rawLines = (content || '').split('\n').map((l: string) => l.trim()).filter(Boolean);
      const isOrdered = rawLines.length > 0 && /^\d+\.\s+/.test(rawLines[0]);
      const listLines = rawLines.map((l: string) => l.replace(/^[-*]\s+|\d+\.\s+/, ''));

      if (isOrdered) {
        return (
          <ol id={id} class="list-decimal pl-6 my-4 space-y-1.5 text-slate-700 text-base md:text-lg">
            {listLines.map((item: string) => (
              <li set:html={renderInlineMarkdownToHtml(item)} />
            ))}
          </ol>
        );
      }

      return (
        <ul id={id} class="list-disc pl-6 my-4 space-y-1.5 text-slate-700 text-base md:text-lg">
          {listLines.map((item: string) => (
            <li set:html={renderInlineMarkdownToHtml(item)} />
          ))}
        </ul>
      );
    }

    if (type === 'button') {
      const btnStyle = settings.buttonStyle || 'primary';
      const url = settings.buttonUrl || '#';
      const isExternal = url.startsWith('http');
      const styleClass =
        btnStyle === 'secondary'
          ? 'bg-slate-800 hover:bg-slate-900 text-white shadow-xs'
          : btnStyle === 'outline'
          ? 'border border-slate-300 hover:border-blue-600 text-slate-700 hover:text-blue-600 bg-white'
          : 'bg-blue-600 hover:bg-blue-700 text-white shadow-sm shadow-blue-500/20';

      const alignClass =
        settings.align === 'center'
          ? 'text-center'
          : settings.align === 'right'
          ? 'text-right'
          : 'text-left';

      return (
        <div id={id} class={`my-6 ${alignClass}`}>
          <a
            href={url}
            target={isExternal ? '_blank' : '_self'}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            class={`inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm md:text-base transition-all ${styleClass}`}
          >
            <span>{content || 'Explore More'}</span>
            <span>→</span>
          </a>
        </div>
      );
    }

    if (type === 'author-box') {
      return (
        <div
          id={id}
          class="my-8 rounded-2xl border border-slate-200/90 bg-linear-to-br from-slate-50 to-white p-6 shadow-xs flex flex-col sm:flex-row items-center sm:items-start gap-4"
        >
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80"
            alt="Author Avatar"
            class="h-16 w-16 rounded-full object-cover ring-2 ring-blue-500/20 shadow-xs"
          />
          <div class="text-center sm:text-left space-y-1">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <span class="font-bold text-slate-900 text-lg">
                {content || 'Amit Singh'}
              </span>
              <span class="text-xs bg-blue-100 text-blue-700 px-2.5 py-0.5 rounded-full font-medium">
                Author & Lead Architect
              </span>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              Software engineer and publishing architect specializing in Astro, headless CMS patterns, and edge deployment infrastructures.
            </p>
          </div>
        </div>
      );
    }

    if (type === 'table') {
      const tableData = settings.tableData || detectAndParseTable(content) || {
        headers: ['Header 1', 'Header 2'],
        rows: [['Cell 1', 'Cell 2']],
        hasHeader: true,
        alignments: ['left', 'left'],
      };

      const alignments = tableData.alignments || [];
      const getAlignClass = (align?: string) => {
        if (align === 'center') return 'text-center';
        if (align === 'right') return 'text-right';
        return 'text-left';
      };

      return (
        <div id={id} class="my-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xs">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700 divide-y divide-slate-200 border-collapse">
              {tableData.caption && (
                <caption class="py-2.5 px-4 text-xs italic text-slate-500 text-left bg-slate-50/70 border-b border-slate-200">
                  {tableData.caption}
                </caption>
              )}
              {tableData.hasHeader !== false && tableData.headers && tableData.headers.length > 0 && (
                <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-700">
                  <tr class="divide-x divide-slate-200">
                    {tableData.headers.map((h: string, hIdx: number) => (
                      <th
                        class={`px-4 py-3 font-semibold ${getAlignClass(alignments[hIdx])}`}
                        set:html={renderInlineMarkdownToHtml(h)}
                      />
                    ))}
                  </tr>
                </thead>
              )}
              <tbody class="divide-y divide-slate-200 bg-white">
                {tableData.rows.map((row: string[]) => (
                  <tr class="divide-x divide-slate-200 hover:bg-slate-50/70 transition-colors odd:bg-white even:bg-slate-50/30">
                    {row.map((cell: string, cIdx: number) => (
                      <td
                        class={`px-4 py-3 leading-relaxed ${getAlignClass(alignments[cIdx])}`}
                        set:html={renderInlineMarkdownToHtml(cell)}
                      />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    }

    if (type === 'download-button') {
      const btnStyle = settings.buttonStyle || 'primary';
      const url = settings.downloadUrl || settings.buttonUrl || '#';
      const text = settings.downloadText || content || 'Download File';
      const fileName = settings.downloadFileName || '';
      const isExternal = url.startsWith('http://') || url.startsWith('https://');

      const styleClass =
        btnStyle === 'secondary'
          ? 'bg-slate-800 hover:bg-slate-900 text-white shadow-xs'
          : btnStyle === 'outline'
          ? 'border-2 border-slate-300 hover:border-blue-600 text-slate-700 hover:text-blue-600 bg-white'
          : 'bg-blue-600 hover:bg-blue-700 text-white shadow-sm shadow-blue-500/20';

      const alignment = settings.downloadAlignment || settings.align || 'left';
      const alignClass =
        alignment === 'center'
          ? 'text-center'
          : alignment === 'right'
          ? 'text-right'
          : 'text-left';

      return (
        <div id={id} class={`my-6 ${alignClass}`}>
          <a
            href={url}
            download={fileName ? fileName : true}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            class={`inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm md:text-base transition-all ${styleClass}`}
          >
            <span>📥</span>
            <span>{text}</span>
            {fileName && (
              <span class="text-[11px] font-normal opacity-75">({fileName})</span>
            )}
          </a>
        </div>
      );
    }

    if (type === 'divider') {
      return <hr id={id} class="my-8 border-slate-200" />;
    }

    if (type === 'spacer') {
      return <div id={id} class="h-8 md:h-12" aria-hidden="true" />;
    }

    return (
      <div id={id} class="my-4 text-slate-700 text-base leading-relaxed" set:html={renderInlineMarkdownToHtml(content)} />
    );
  })}
</div>
