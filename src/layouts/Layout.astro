---
import '../index.css';
// Read the admin-controlled settings file, NOT initialData.ts.
// initialData.ts has no write path anywhere in the codebase, so every SEO/meta
// value read from it was frozen at seed values and ignored all admin edits.
// siteSettings.json is written on GitHub publish and rebuilt by Cloudflare Pages,
// so reading it here makes the dashboard the real source of truth for the <head>.
import siteSettingsJson from '../data/siteSettings.json';

const siteSettings: any = (siteSettingsJson as any) || {};
const adsSettings = siteSettings.adsSettings || { adsEnabled: true, publisherId: '', autoAdsEnabled: false };
const scriptsSettings = siteSettings.scriptsSettings || { integrations: [], consentBanner: { enabled: true, noticeText: '', privacyPolicyUrl: '/privacy-policy/' } };
const activeIntegrations = (scriptsSettings.integrations || []).filter((i: any) => i.enabled && i.configValue && i.configValue.trim());

// Deduplicated AdSense publisher ID: check scripts integration or adsSettings.publisherId
const resolvedAdsensePubId = (
  activeIntegrations.find((i: any) => i.providerKey === 'adsense')?.configValue ||
  (adsSettings.adsEnabled ? adsSettings.publisherId : '')
)?.trim();
const shouldLoadAdsense = adsSettings.adsEnabled && !!resolvedAdsensePubId;

const ga4Integration = activeIntegrations.find((i: any) => i.providerKey === 'ga4');
const gtmIntegration = activeIntegrations.find((i: any) => i.providerKey === 'gtm');
const metaPixelIntegration = activeIntegrations.find((i: any) => i.providerKey === 'metaPixel');
const verificationIntegration = activeIntegrations.find((i: any) => i.providerKey === 'verification');
const customHeadIntegrations = activeIntegrations.filter((i: any) => i.placement === 'head' && i.providerKey === 'customHead');
const bodyStartIntegrations = activeIntegrations.filter((i: any) => i.placement === 'body-start' || i.providerKey === 'bodyStart');
const bodyEndIntegrations = activeIntegrations.filter((i: any) => i.placement === 'body-end' || i.providerKey === 'bodyEnd');

const consentEnabled = scriptsSettings.consentBanner?.enabled !== false;
const consentNotice = scriptsSettings.consentBanner?.noticeText || 'We use cookies and similar technologies to enhance your experience, analyze site traffic, and serve personalized advertisements.';
const privacyUrl = scriptsSettings.consentBanner?.privacyPolicyUrl || '/privacy-policy/';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  robotsDirective?: string;
  ogType?: string;
  schemaData?: any;
}

const siteTitle = siteSettings.siteTitle || 'AstroPress';
const rawSiteUrl = (siteSettings.siteUrl || '').trim();
// Automatically sanitize any historical typo ("astropress.pages.dev" -> "astro-press.pages.dev")
const siteUrl = (rawSiteUrl === 'https://astropress.pages.dev' || !rawSiteUrl
  ? 'https://astro-press.pages.dev'
  : rawSiteUrl
).replace(/\/+$/, '');

const twitterHandle = siteSettings.seoSocialProfiles?.twitterHandle || '';
const defaultOg = siteSettings.defaultOgImage || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80';

const {
  title = `${siteTitle} — ${siteSettings.siteTagline || ''}`.trim(),
  description = siteSettings.siteDescription,
  ogImage = defaultOg,
  canonicalUrl: propCanonicalUrl,
  robotsDirective = "index, follow",
  ogType = "website",
  schemaData,
} = Astro.props;

const rawCanonical = propCanonicalUrl || (
  Astro.site && siteUrl
    ? new URL(Astro.url.pathname, siteUrl).href
    : (siteUrl ? `${siteUrl}${Astro.url.pathname}` : Astro.url.href)
);
const canonicalUrl = rawCanonical.replace('https://astropress.pages.dev', siteUrl);

// Open Graph and Twitter both require absolute image URLs. Uploads are stored
// as root-relative paths (/uploads/x.webp), which social scrapers cannot resolve.
const rawOgImage = (ogImage && typeof ogImage === 'string' && ogImage.trim() !== '')
  ? ogImage.trim()
  : defaultOg;

const absoluteOgImage = /^https?:\/\//i.test(rawOgImage)
  ? rawOgImage.replace('https://astropress.pages.dev', siteUrl)
  : `${siteUrl}${rawOgImage.startsWith('/') ? '' : '/'}${rawOgImage}`;

const imageExt = absoluteOgImage.split('?')[0].split('.').pop()?.toLowerCase();
const ogImageType = imageExt === 'webp'
  ? 'image/webp'
  : imageExt === 'png'
  ? 'image/png'
  : (imageExt === 'jpg' || imageExt === 'jpeg')
  ? 'image/jpeg'
  : imageExt === 'gif'
  ? 'image/gif'
  : undefined;

const defaultProfiles = siteSettings.seoSocialProfiles || {};
const sameAsUrls = [
  defaultProfiles.facebookUrl,
  defaultProfiles.instagramUrl,
  defaultProfiles.youtubeUrl,
  defaultProfiles.linkedinUrl,
  defaultProfiles.githubUrl,
  defaultProfiles.twitterHandle ? `https://x.com/${defaultProfiles.twitterHandle.replace(/^@/, '')}` : undefined,
].filter(Boolean);

const siteLogoUrl = siteSettings.logoUrl;
// Previously fell back to /favicon.ico, which does not exist in public/, so
// every single page view produced a 404 for the favicon.
const siteFaviconUrl = siteSettings.faviconUrl || '/favicon.svg';

// Theme colours and body font are applied on the static <body> rather than as an
// inline style on the hydrated React root. The browser's CSSOM normalises inline
// style values (hex -> rgb(), and it re-quotes multi-word font names), so React's
// server serialisation and the client's first render never matched on that
// element. Because it was the outermost node of the island, that difference made
// React discard the entire hydrated tree. The same declarations on <body> give
// identical computed styles through inheritance and React never touches them.
import themeSettingsJson from '../data/themeSettings.json';
import heroConfigJson from '../data/heroConfig.json';
const themeSettings: any = (themeSettingsJson as any) || {};
const heroConfig: any = (heroConfigJson as any) || {};
const themeFont =
  themeSettings.bodyFont === 'Source Serif 4'
    ? 'Source Serif 4, Georgia, serif'
    : 'Plus Jakarta Sans, system-ui, -apple-system, BlinkMacSystemFont, sans-serif';

// Admin-configurable brand colours are exposed as CSS custom properties here and
// consumed by the React components via var(--ap-*).
//
// The browser's CSSOM normalises inline style values (hex -> rgb(), multi-word
// font names re-quoted), so a literal colour written as an inline style on a
// server-rendered React element never matched the client's first render. Custom
// property values are token streams and are preserved verbatim by CSSOM, so
// var() references are stable across SSR and hydration. The exact colours,
// typography, spacing, layout and responsive behaviour are unchanged.
const brandVars = [
  `--ap-primary:${themeSettings.primaryColor || '#2563eb'}`,
  `--ap-accent:${heroConfig.svgAccentColor || themeSettings.primaryColor || '#2563eb'}`,
  `--ap-hero-text:${heroConfig.textColor || '#0f172a'}`,
  `--ap-hero-desc:${heroConfig.descriptionColor || '#475569'}`,
  `--ap-hero-eyebrow-bg:${heroConfig.eyebrowBgColor || 'rgba(37, 99, 235, 0.08)'}`,
  `--ap-hero-eyebrow-text:${heroConfig.eyebrowTextColor || '#2563eb'}`,
  `--ap-hero-btn-bg:${heroConfig.primaryButtonBgColor || heroConfig.svgAccentColor || '#2563eb'}`,
  `--ap-hero-btn-text:${heroConfig.primaryButtonTextColor || '#ffffff'}`,
].join(';');

const bodyStyle = `${brandVars};background-color:${themeSettings.backgroundColor || '#f8fafc'};color:${themeSettings.textColor || '#0f172a'};font-family:${themeFont}`;

const organizationSchema: any = {
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: siteTitle,
  url: siteUrl,
  description: description,
  sameAs: sameAsUrls.length > 0 ? sameAsUrls : undefined,
};
if (siteLogoUrl) {
  organizationSchema.logo = {
    '@type': 'ImageObject',
    url: siteLogoUrl,
  };
}

const defaultSchemaGraph = schemaData || {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: siteTitle,
      description: description,
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function() {
        try {
          var noopSig = function() { return function(type) { return type; }; };
          var noopReg = function(type) { return type; };
          window.$RefreshReg$ = noopReg;
          window.$RefreshSig$ = noopSig;
          window.RefreshRuntime = {
            injectIntoGlobalHook: function() {},
            register: noopReg,
            createSignatureFunctionForTransform: noopSig,
            registerExportsForReactRefresh: function() {},
            validateRefreshBoundaryAndEnqueueUpdate: function() {},
            performReactRefresh: function() {},
            isLikelyComponentType: function() { return true; },
            setSignature: function() {},
            collectCustomHooksForSignature: function() {},
            getFamilyByType: function() {},
            getFamilyByID: function() {},
            hasUnrecoverableErrors: function() { return false; },
            __hmr_import: function() { return Promise.resolve({}); }
          };

          // 1. Capture and suppress unhandled extension/sandbox errors in capturing phase
          window.addEventListener('error', function(event) {
            var msg = (event && (event.message || (event.error && (event.error.message || event.error.stack)))) || '';
            var file = (event && (event.filename || '')) || '';
            if (
              (typeof msg === 'string' && (
                msg.indexOf('Cannot set property fetch') !== -1 ||
                msg.indexOf('before-hydration') !== -1
              )) ||
              (typeof file === 'string' && (
                file.indexOf('chrome-extension://') !== -1 ||
                file.indexOf('before-hydration') !== -1
              ))
            ) {
              if (event.preventDefault) event.preventDefault();
              if (event.stopImmediatePropagation) event.stopImmediatePropagation();
              return true;
            }
          }, true);

          window.addEventListener('unhandledrejection', function(event) {
            var reason = event && event.reason;
            var msg = (reason && (reason.message || reason.stack)) || (typeof reason === 'string' ? reason : '');
            if (
              typeof msg === 'string' && (
                msg.indexOf('Cannot set property fetch') !== -1 ||
                msg.indexOf('chrome-extension://') !== -1 ||
                msg.indexOf('before-hydration') !== -1
              )
            ) {
              if (event.preventDefault) event.preventDefault();
              if (event.stopImmediatePropagation) event.stopImmediatePropagation();
            }
          }, true);

          var prevOnError = window.onerror;
          window.onerror = function(msg, url, lineNo, colNo, error) {
            var m = (typeof msg === 'string' ? msg : '') || (error && (error.message || error.stack)) || '';
            var u = typeof url === 'string' ? url : '';
            if (
              m.indexOf('Cannot set property fetch') !== -1 ||
              u.indexOf('chrome-extension://') !== -1
            ) {
              return true;
            }
            if (prevOnError) return prevOnError.apply(this, arguments);
          };

          // 2. Filter console.error and console.warn for known sandbox/extension artifacts
          var origError = console.error;
          console.error = function() {
            var allText = Array.prototype.slice.call(arguments).map(function(arg) {
              if (!arg) return '';
              if (typeof arg === 'string') return arg;
              if (arg.message || arg.stack) return (arg.message || '') + ' ' + (arg.stack || '');
              try { return String(arg); } catch(_) { return ''; }
            }).join(' ');

            if (
              allText.indexOf('Cannot set property fetch') !== -1 ||
              allText.indexOf('chrome-extension://') !== -1 ||
              allText.indexOf('send was called before connect') !== -1 ||
              allText.indexOf('WebSocket') !== -1 ||
              allText.indexOf('vite:ws') !== -1
            ) {
              return;
            }
            origError.apply(console, arguments);
          };

          var origWarn = console.warn;
          console.warn = function() {
            var allText = Array.prototype.slice.call(arguments).map(function(arg) {
              if (!arg) return '';
              if (typeof arg === 'string') return arg;
              try { return String(arg); } catch(_) { return ''; }
            }).join(' ');

            if (
              allText.indexOf('send was called before connect') !== -1 ||
              allText.indexOf('WebSocket') !== -1 ||
              allText.indexOf('vite:ws') !== -1
            ) {
              return;
            }
            origWarn.apply(console, arguments);
          };

          // 3. Make fetch assignable across window and entire prototype chain
          try {
            var _nativeFetch = window.fetch;
            var _activeFetch = _nativeFetch;
            var curr = window;
            while (curr) {
              try {
                var d = Object.getOwnPropertyDescriptor(curr, 'fetch');
                if (d && !d.set && d.configurable !== false) {
                  Object.defineProperty(curr, 'fetch', {
                    get: function() { return _activeFetch || _nativeFetch; },
                    set: function(val) { _activeFetch = typeof val === 'function' ? val : _nativeFetch; },
                    configurable: true,
                    enumerable: true
                  });
                }
              } catch (_) {}
              curr = Object.getPrototypeOf(curr);
            }
            try {
              var winDesc = Object.getOwnPropertyDescriptor(window, 'fetch');
              if (!winDesc || winDesc.configurable !== false) {
                Object.defineProperty(window, 'fetch', {
                  get: function() { return _activeFetch || _nativeFetch; },
                  set: function(val) { _activeFetch = typeof val === 'function' ? val : _nativeFetch; },
                  configurable: true,
                  enumerable: true
                });
              }
            } catch (_) {}
          } catch (_) {}
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={siteFaviconUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" id="astropress-schema" set:html={JSON.stringify(defaultSchemaGraph, null, 2)} />
    {shouldLoadAdsense && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${resolvedAdsensePubId}`} crossorigin="anonymous"></script>
    )}
    {ga4Integration && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Integration.configValue}`}></script>
        <script is:inline define:vars={{ gaId: ga4Integration.configValue }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {gtmIntegration && (
      <script is:inline define:vars={{ gtmId: gtmIntegration.configValue }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='gtm.src'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    {metaPixelIntegration && (
      <script is:inline define:vars={{ pixelId: metaPixelIntegration.configValue }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
    {verificationIntegration && (
      <meta name="google-site-verification" content={verificationIntegration.configValue.replace('google-site-verification=', '')} />
    )}
    {customHeadIntegrations.map((item: any) => (
      <Fragment set:html={item.configValue} />
    ))}
    {siteSettings.customHeadCode && (
      <Fragment set:html={siteSettings.customHeadCode} />
    )}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased font-sans" style={bodyStyle}>
    {bodyStartIntegrations.map((item: any) => (
      <Fragment set:html={item.configValue} />
    ))}
    <slot />
    {consentEnabled && (
      <div id="astropress-consent-banner" class="fixed bottom-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-md text-white p-4 shadow-2xl border-t border-slate-800 hidden">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-300 leading-relaxed">
            {consentNotice} <a href={privacyUrl} class="underline text-blue-400 hover:text-blue-300">Privacy Policy</a>
          </p>
          <div class="flex items-center gap-3 shrink-0">
            <button type="button" id="astropress-consent-accept" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs transition-colors cursor-pointer">
              Accept All
            </button>
            <button type="button" id="astropress-consent-decline" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition-colors cursor-pointer">
              Essential Only
            </button>
          </div>
        </div>
      </div>
      <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
          if (!localStorage.getItem('astropress_cookie_consent')) {
            var banner = document.getElementById('astropress-consent-banner');
            if (banner) banner.classList.remove('hidden');
          }
          var acceptBtn = document.getElementById('astropress-consent-accept');
          if (acceptBtn) {
            acceptBtn.addEventListener('click', function() {
              localStorage.setItem('astropress_cookie_consent', 'accepted');
              var banner = document.getElementById('astropress-consent-banner');
              if (banner) banner.classList.add('hidden');
            });
          }
          var declineBtn = document.getElementById('astropress-consent-decline');
          if (declineBtn) {
            declineBtn.addEventListener('click', function() {
              localStorage.setItem('astropress_cookie_consent', 'essential');
              var banner = document.getElementById('astropress-consent-banner');
              if (banner) banner.classList.add('hidden');
            });
          }
        });
      </script>
    )}
    {bodyEndIntegrations.map((item: any) => (
      <Fragment set:html={item.configValue} />
    ))}
    {siteSettings.customFooterCode && (
      <Fragment set:html={siteSettings.customFooterCode} />
    )}
  </body>
</html>
