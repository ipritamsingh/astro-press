---
import Layout from '../../layouts/Layout.astro';
import { WebsiteHeaderWrapper } from '../../components/frontend/WebsiteHeaderWrapper';
import { WebsiteFooterWrapper } from '../../components/frontend/WebsiteFooterWrapper';
import { SocialCommunityCta } from '../../components/frontend/SocialCommunityCta';
import { ArchiveViewWrapper } from '../../components/frontend/ArchiveViewWrapper';
import { getCollection } from 'astro:content';
import { initialThemeSettings, initialCategories, initialMenus } from '../../data/initialData';
import themeSettingsJson from '../../data/themeSettings.json';
import siteSettingsJson from '../../data/siteSettings.json';
import categoriesJson from '../../data/categories.json';
import menusJson from '../../data/menus.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categoriesList = categoriesJson?.categories || initialCategories;

  return categoriesList.map((cat: any) => ({
    params: { slug: cat.slug || cat.name.toLowerCase().replace(/\s+/g, '-') },
    props: { category: cat },
  }));
}

const { category } = Astro.props as any;

const rawCollectionPosts = await getCollection('posts');
const rawCollectionPages = await getCollection('pages');

const allPublishedPosts = rawCollectionPosts
  .filter((p) => !p.data.draft && p.data.status !== 'draft' && p.data.status !== 'trash')
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    slug: p.data.slug || p.id.replace(/\.md$/, ''),
    pubDate: p.data.pubDate ? new Date(p.data.pubDate).toISOString() : new Date().toISOString(),
    status: 'published' as const,
    author: p.data.author,
    category: p.data.category,
    tags: p.data.tags || [],
    featuredImage: p.data.featuredImage || '',
    excerpt: p.data.excerpt || '',
    readingTime: p.data.readingTime || 5,
    template: p.data.template || 'standard',
    blocks: p.data.blocks || [],
    body: p.body || '',
    seo: p.data.seo || {},
  }))
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

const allPages = rawCollectionPages.map((p) => ({
  id: p.id,
  title: p.data.title,
  slug: p.data.slug || p.id.replace(/\.md$/, ''),
  status: p.data.draft ? 'draft' : 'published',
  template: p.data.template || 'default',
  blocks: p.data.blocks || [],
  body: p.body || '',
}));

const themeSettings = themeSettingsJson || initialThemeSettings;
const siteSettings = siteSettingsJson;
const categories = categoriesJson?.categories || initialCategories;
const menus = menusJson || initialMenus;
---

<Layout title={`${category.name} Archive — AstroPress`}>
  <div class="min-h-screen flex flex-col font-sans">
    <WebsiteHeaderWrapper
      client:load
      posts={allPublishedPosts as any}
      pages={allPages as any}
      categories={categories as any}
      themeSettings={themeSettings as any}
      menus={menus as any}
      permalinkStructure={siteSettings?.permalinkStructure}
    />

    <main class="flex-1 w-full">
      <ArchiveViewWrapper
        client:load
        type="category"
        item={category}
        posts={allPublishedPosts as any}
        permalinkStructure={siteSettings?.permalinkStructure}
      />
    </main>

    <SocialCommunityCta
      enabled={siteSettings?.communityCtaEnabled !== false}
      title={siteSettings?.communityCtaTitle}
      subtitle={siteSettings?.communityCtaSubtitle}
      communityLinks={siteSettings?.communityLinks}
    />

    <WebsiteFooterWrapper
      client:load
      themeSettings={themeSettings as any}
      siteSettings={siteSettings as any}
      menus={menus as any}
      categories={categories as any}
    />
  </div>
</Layout>
