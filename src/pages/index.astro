---
import Layout from '../layouts/Layout.astro';
import App from '../App';
import { getCollection } from 'astro:content';
import siteSettingsJson from '../data/siteSettings.json';
import categoriesJson from '../data/categories.json';
import menusJson from '../data/menus.json';
import themeSettingsJson from '../data/themeSettings.json';
import heroConfigJson from '../data/heroConfig.json';

const siteSettings: any = (siteSettingsJson as any) || {};
const siteTitle: string = siteSettings.siteTitle || 'AstroPress';
const siteTagline: string = siteSettings.siteTagline || '';

const collectionPosts = await getCollection('posts');
const serverPosts = collectionPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  slug: post.data.slug || post.id.replace(/\.md$/, ''),
  pubDate: post.data.pubDate ? new Date(post.data.pubDate).toISOString() : new Date().toISOString(),
  status: (post.data.draft ? 'draft' : (post.data.status || 'published')) as any,
  author: post.data.author,
  category: post.data.category,
  tags: post.data.tags || [],
  featuredImage: post.data.featuredImage || '',
  excerpt: post.data.excerpt || '',
  readingTime: post.data.readingTime || 5,
  template: post.data.template || 'standard',
  blocks: post.data.blocks || [],
  body: post.body || '',
  seo: post.data.seo || {},
}));

const publishedPosts = serverPosts
  .filter((p) => p.status !== 'draft' && p.status !== 'trash')
  .sort((a, b) => {
    const timeA = new Date(a.pubDate || 0).getTime();
    const timeB = new Date(b.pubDate || 0).getTime();
    if (timeB !== timeA) {
      return timeB - timeA;
    }
    return (a.slug || '').localeCompare(b.slug || '');
  });
const seedCategories: any = (categoriesJson as any)?.categories || (categoriesJson as any) || [];
const seedMenus: any = (menusJson as any)?.menus || (menusJson as any) || [];
const seedTheme: any = (themeSettingsJson as any) || {};
const seedHero: any = (heroConfigJson as any) || {};
---

<Layout title={`${siteTitle} — ${siteTagline}`} description={siteSettings.siteDescription}>
  <script is:inline define:vars={{ serverPosts }}>
    window.__ASTROPRESS_SERVER_POSTS__ = serverPosts;
  </script>
  <App
    client:load
    seed={{
      posts: publishedPosts as any,
      categories: seedCategories,
      menus: seedMenus,
      themeSettings: seedTheme,
      heroConfig: seedHero,
      siteSettings: siteSettings,
    }}
    initialRoute={{ type: 'home' }}
  />
</Layout>
