# AstroPress Environment Secrets Example
# Copy this file to .env.local for local development or configure in Cloudflare Pages Dashboard.

# Production domain origin used for secure email password reset link generation (HTTPS recommended)
SITE_URL=https://astro-press.pages.dev

# Resend API Key for sending transactional password reset emails
RESEND_API_KEY=re_YourResendApiKeyHere
